__pycache__/
*.pyc

# generated: word cache, decomposed SVGs, sweep results
.cache/words/
.cache/words-svg/
.cache/sweeps/

# bench scratch renders
scratchpad/bpx*
scratchpad/marks_pages/
scratchpad/marks_report.txt
tools/interval_flags.json

# never commit
sudo.txt
mushafs/

# backups of the human-confirmed data (the live files ARE committed)
.cache/review/*.bak*
# the KFGQPC word text, fetched from quran.com on first use like .cache/words/
.cache/words-qpc/
# per-word confidence, regenerated by tools/score_confidence.py
.cache/confidence/
.cache/words-dk/
.cache/marktype/

# one-off experiment caches (regenerable, never inputs to a gate)
.cache/fusedscan/
.cache/hdrink/
.cache/hdrink2/
.cache/markerink/
.cache/pausedots/
.cache/slashx/
.cache/slashx2/
.cache/slashx3/
.cache/pixel_fails.json
.playwright-mcp/

# derived: MushafDatabase run table, rebuilt by tools/build_mdb_runs.py
.cache/mdb_runs.json
# derived: the per-page annotation graph, rebuilt by tools/build_annotations.py
.cache/annotations/
