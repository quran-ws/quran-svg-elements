__pycache__/
*.pyc

# generated: word cache, decomposed SVGs, sweep results
.cache/words/
.cache/words-svg/
.cache/sweeps/

# bench scratch renders
scratchpad/bpx*
scratchpad/marks_pages/
scratchpad/marks_report.txt
tools/interval_flags.json

# never commit
sudo.txt
mushafs/

# the shippable bundle and its page staging cache, both rebuilt by
# tools/build_bundle.py — 786 MB of derived output, never committed
dist/
.cache/bundle-pages/

# backups of the human-confirmed data (the live files ARE committed)
.cache/review/*.bak*
# the KFGQPC word text, fetched from quran.com on first use like .cache/words/
.cache/words-qpc/
# per-word confidence, regenerated by tools/score_confidence.py
.cache/confidence/
.cache/words-dk/
.cache/marktype/

# one-off experiment caches (regenerable, never inputs to a gate)
.cache/fusedscan/
.cache/hdrink/
.cache/hdrink2/
.cache/markerink/
.cache/pausedots/
.cache/slashx/
.cache/slashx2/
.cache/slashx3/
.cache/pixel_fails.json
.playwright-mcp/

# derived: MushafDatabase run table, rebuilt by tools/build_mdb_runs.py
.cache/mdb_runs.json
# derived: the per-page annotation graph, rebuilt by tools/build_annotations.py
.cache/annotations/

# local state of the maestro plugin, not part of the project
.maestro/

MushafDatabase-Ligature-Based-SVG/

# a local clone of quran-ws/quran-assets, symlinked in so the demo's ornament
# section can be developed against the full 8-mushaf set. The demo ships only
# the one-mushaf fallback that build.py vendors into docs/demo/data/ornaments/.
docs/demo/ornaments

# derived: per-page flag files from tools/audit_marks.py
.cache/marks_pages/
