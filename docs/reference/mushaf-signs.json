      "example": {
        "ref": "6:36",
        "text": "إِنَّمَا يَسْتَجِيبُ ٱلَّذِينَ يَسْمَعُونَ ۘ وَٱلْمَوْتَىٰ يَبْعَثُهُمُ ٱللَّهُ"
      },
      "folio": "ث",
      "appendix_pdf_page": 630
    },
    {
      "id": "waqf_awla",
      "glyph": "ۗ",
      "codepoint": "U+06D7",
      "name_ar": "الوقف الجائز مع كون الوقف أولى",
      "name_en": "Stopping preferred",
      "rule": "Both permitted; stopping is better.",
      "example": {
        "ref": "13:28",
        "text": "وَتَطْمَئِنُّ قُلُوبُهُم بِذِكْرِ ٱللَّهِ ۗ أَلَا بِذِكْرِ ٱللَّهِ تَطْمَئِنُّ ٱلْقُلُوبُ"
      },
      "folio": "ث",
      "appendix_pdf_page": 630
    },
    {
      "id": "waqf_jaiz",
      "glyph": "ۚ",
      "codepoint": "U+06DA",
      "name_ar": "الوقف الجائز جوازا مستوي الطرفين",
      "name_en": "Permissible stop, both equal",
      "rule": "Stopping and continuing are equally sound.",
      "example": {
        "ref": "18:13",
        "text": "نَّحْنُ نَقُصُّ عَلَيْكَ نَبَأَهُم بِٱلْحَقِّ ۚ إِنَّهُمْ فِتْيَةٌ ءَامَنُواْ بِرَبِّهِمْ"
      },
      "folio": "ث",
      "appendix_pdf_page": 630
    },
    {
